# 이 파일을 .env로 복사해서 값을 채우세요. .env는 git에 올라가지 않습니다.

# 기상청 API허브 인증키 (없으면 /api/warnings, /api/forecast가 503)
KMA_API_KEY=

# Google AI Studio Gemini 키 (없으면 기사 분석을 키워드 규칙으로 대신함)
GEMINI_API_KEY=
# GEMINI_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite

# 크롤러가 POST /api/articles 할 때 X-Ingest-Token 헤더로 보내는 값 (필수, 없으면 503)
# 만들기: python -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_TOKEN=

# 프론트엔드 주소, 쉼표로 여러 개 (기본 http://localhost:8000)
# ALLOWED_ORIGINS=https://jsonparc.github.io,http://localhost:8000

# SQLite 파일 위치 (기본 ./data.db). 재시작 때 지워지지 않는 디스크에 두세요.
# DB_PATH=
